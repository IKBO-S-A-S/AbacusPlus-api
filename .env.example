# PostgreSQL
DATABASE_HOST=abacus_db
DATABASE_PORT=5432
DATABASE_USER=master
DATABASE_PASSWORD=master
DATABASE_NAME=abacus

# JWT RS256 — auth-service + todos los servicios que validan tokens
# Generar con: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# Luego: awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' private.pem
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n

# Secret compartido para llamadas internas entre servicios (sin JWT de usuario)
INTERNAL_SECRET=change-me

# Tokens JWT — expiración
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Dominio base de la app (usado por auth-service para cookies/CORS)
APP_BASE_DOMAIN=app.abacusplus.com

# OpenAI (llm-service)
OPENAI_API_KEY=

# Ollama (rag-service + accounting-rules-service)
OLLAMA_HOST=http://ollama:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# URLs inter-servicio (sobreescritas en docker-compose con nombres de contenedor)
RAG_SERVICE_URL=http://rag-service:8002
LLM_SERVICE_URL=http://llm-service:8003
XML_PROCESSOR_URL=http://xml-processor:8001

# Odoo (odoo-service)
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USER=admin
ODOO_PASSWORD=admin

# SIIGO (siigo-service)
SIIGO_BASE_URL=https://api.siigo.com
SIIGO_CHART_ACCOUNTS_PATH=/v1/accounts

# session-proxy (portal DIAN)
EXTERNAL_BASE_URL=https://catalogo-vpfe.dian.gov.co
EXTERNAL_LOGIN_PATH=/User/AuthToken
SESSION_TTL_SECONDS=3600
BROWSER_TIMEOUT_MS=60000
# Credenciales fijas opcionales para el proxy DIAN
# pk = partner key (formato: nit_empresa|nit_representante)
# rk = representative key (nit del representante legal)
EXTERNAL_FIXED_PK=
EXTERNAL_FIXED_RK=
REPRESENTATIVE=
NIT=
# Descarga de ZIPs — Turnstile del endpoint DownloadZipFiles (?captcha=token)
# channel=chrome usa Google Chrome real (mejor evasión). CapSolver es el fallback pago.
BROWSER_CHANNEL=chrome
CAPSOLVER_API_KEY=
TURNSTILE_SITEKEY=0x4AAAAAAAg1WuNb-OnOa76z
# Con patchright + Chrome real + perfil persistente (cf_clearance caliente), el widget
# in-browser sí resuelve. CapSolver ProxyLess falla porque DIAN valida IP del token.
TURNSTILE_INBROWSER=true

# Redis
REDIS_URL=redis://redis:6379

# integration-config-service — cifrado de secretos de almacenamiento (S3/SharePoint)
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORAGE_SECRETS_KEY=

